# Copy this file to .env.local and fill in the values.
# .env* is gitignored (except this example), so real keys never get committed.

# ---------------------------------------------------------------------------
# Supabase — required. Accounts, travel data, and photo storage.
# Find both under: Supabase dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL="MY_SUPABASE_URL"

# The browser-safe key, from Settings -> API Keys.
#
# Newer projects call this the "publishable" key and it starts with
# sb_publishable_. Older projects call it the "anon public" key and it looks
# like a long JWT. Either works — set whichever your dashboard shows.
#
# It is safe to ship in the browser bundle: every table has row level
# security, so on its own it grants access to nobody's data.
#
# Never use the "secret" key (sb_secret_...) or the legacy "service_role" key
# here or anywhere else in this project. Those bypass row level security
# entirely and must stay server-side only — this app never needs them.
VITE_SUPABASE_PUBLISHABLE_KEY="MY_SUPABASE_PUBLISHABLE_KEY"

# ---------------------------------------------------------------------------
# Gemini
#
# The Gemini key is NOT set here. The AI features run inside the Supabase Edge
# Function (supabase/functions/ai), so the key lives in that function's secrets
# and is never served to a browser:
#
#   supabase secrets set GEMINI_API_KEY=your-key-here
#   supabase secrets set GEMINI_MODEL=gemini-3.6-flash   # optional
# ---------------------------------------------------------------------------
